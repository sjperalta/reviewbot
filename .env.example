# GitHub Personal Access Token with repo scope
# Required: Used to fetch PR data and publish reviews
GITHUB_TOKEN=

# DeepSeek API Key
# Optional: If not set, reviewbot runs static analysis only
DEEPSEEK_API_KEY=

# Default base branch for PR diff comparison
# Optional: Defaults to main
DEFAULT_BASE_BRANCH=main

# Workspace directory for cloning repositories
# Optional: Defaults to ~/.reviewbot/workspace
REVIEWBOT_WORKSPACE=

# Output directory for review reports
# Optional: Defaults to ./reviews/
REVIEWBOT_OUTPUT_DIR=

# Log level (debug, info, warn, error)
# Optional: Defaults to info
REVIEWBOT_LOG_LEVEL=info
